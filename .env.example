# Parser TCP, do którego symulator wysyła ramki Codec 8 Extended.
TELTONIKA_HOST=127.0.0.1
TELTONIKA_PORT=5027

# Jedno IMEI albo lista rozdzielona przecinkami. Każde IMEI to osobna instancja pojazdu.
TELTONIKA_IMEIS=356307042441013

TELTONIKA_DEVICE_PROFILE=default-codec8e
TELTONIKA_DRIVING_STYLE=normal
TELTONIKA_ROUTE_FILE=routes/rotterdam-genoa.route.json
TELTONIKA_SEED=1
TELTONIKA_INTERVAL_MS=1000
TELTONIKA_RECONNECT_DELAY_MS=5000
