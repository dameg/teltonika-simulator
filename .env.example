POSTGRES_DB=teltonika
POSTGRES_USER=teltonika
POSTGRES_PASSWORD=teltonika-local
POSTGRES_PORT=5432
DATABASE_URL=postgresql://teltonika:teltonika-local@127.0.0.1:5432/teltonika
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Integration tests use the isolated, temporary postgres-test Compose service.
POSTGRES_TEST_PORT=5433
TEST_DATABASE_URL=postgresql://teltonika_test:teltonika-test@127.0.0.1:5433/teltonika_test
